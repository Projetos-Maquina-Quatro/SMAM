# Postgres do Railway (Variables > DATABASE_URL). Use a URL publica para rodar local.
DATABASE_URL="postgresql://usuario:senha@host:porta/railway"

# Segredo para assinar os tokens JWT. Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-valor"

# Origens liberadas no CORS (separadas por virgula). O dominio do Netlify entra aqui.
CORS_ORIGINS="http://localhost:5173"

PORT=3333
